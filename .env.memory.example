# .env Configuration Example - Memory System Settings

# ============================================================================
# MEMORY SYSTEM CONFIGURATION
# ============================================================================
# Add these variables to your .env file to configure the memory system

# Enable/disable the entire memory system
MEMORY_ENABLED=true

# ============================================================================
# MESSAGE LISTENING & STORAGE
# ============================================================================

# Listen to all incoming and outgoing messages
MEMORY_LISTEN_MESSAGES=true

# Store media references (images, videos, audio, documents, stickers)
MEMORY_STORE_MEDIA=true

# Store document metadata
MEMORY_STORE_DOCUMENTS=true

# Extract and store links/URLs from messages
MEMORY_STORE_LINKS=true

# Store the bot's own messages (bot-to-user responses)
MEMORY_STORE_OWN_MESSAGES=true

# Extract metadata like dates, emails, phones, locations, etc.
MEMORY_EXTRACT_METADATA=true

# ============================================================================
# BACKUP & STORAGE
# ============================================================================

# Enable automatic backup to Google Drive (requires configuration)
# See modules/memory/GDRIVE_SETUP.md for setup instructions
MEMORY_GDRIVE_BACKUP=false

# Interval between automatic backups (in milliseconds)
# Default: 30 minutes (1800000 ms)
MEMORY_BACKUP_INTERVAL=1800000

# Maximum local storage size before cleanup (in bytes)
# Default: 500 MB (524288000 bytes)
MEMORY_MAX_LOCAL_STORAGE=524288000

# Enable compression for backups
MEMORY_COMPRESSION=true

# ============================================================================
# FEATURES
# ============================================================================

# Track group information and participant activity
MEMORY_GROUP_TRACKING=true

# Build and maintain user profiles with statistics
MEMORY_USER_PROFILES=true

# Collect daily message statistics
MEMORY_STATISTICS=true

# ============================================================================
# MAINTENANCE & CLEANUP
# ============================================================================

# Interval for cleanup and archiving tasks (in milliseconds)
# Default: 24 hours (86400000 ms)
MEMORY_CLEANUP_INTERVAL=86400000

# Archive messages older than this many days
# Messages older than this threshold are moved to archive/
# Default: 30 days
MEMORY_ARCHIVE_DAYS=30

# Maximum number of messages in the processing queue
# Increase for high-volume bots, decrease to reduce memory usage
# Default: 1000
MEMORY_QUEUE_SIZE=1000

# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# For a private bot with minimal storage:
# MEMORY_ENABLED=true
# MEMORY_LISTEN_MESSAGES=true
# MEMORY_STORE_MEDIA=false
# MEMORY_STORE_DOCUMENTS=false
# MEMORY_BACKUP_INTERVAL=3600000
# MEMORY_ARCHIVE_DAYS=7

# For a high-volume bot with Google Drive:
# MEMORY_ENABLED=true
# MEMORY_LISTEN_MESSAGES=true
# MEMORY_STORE_MEDIA=true
# MEMORY_GDRIVE_BACKUP=true
# MEMORY_BACKUP_INTERVAL=600000
# MEMORY_QUEUE_SIZE=5000

# For development/testing (minimal storage):
# MEMORY_ENABLED=true
# MEMORY_LISTEN_MESSAGES=true
# MEMORY_GDRIVE_BACKUP=false
# MEMORY_ARCHIVE_DAYS=1
# MEMORY_MAX_LOCAL_STORAGE=104857600

# ============================================================================
# NOTES
# ============================================================================
#
# 1. All times are in milliseconds (ms):
#    - 60000 = 1 minute
#    - 300000 = 5 minutes
#    - 600000 = 10 minutes
#    - 1800000 = 30 minutes
#    - 3600000 = 1 hour
#    - 86400000 = 1 day
#
# 2. All sizes are in bytes:
#    - 1048576 = 1 MB
#    - 104857600 = 100 MB
#    - 524288000 = 500 MB
#    - 1073741824 = 1 GB
#
# 3. For Google Drive backup:
#    - Set MEMORY_GDRIVE_BACKUP=true
#    - Follow setup in modules/memory/GDRIVE_SETUP.md
#    - Configuration stored in database/memory/gdrive_config.json
#
# 4. Memory data is stored in:
#    - database/memory/ (main memory data)
#    - database/memory/logs/ (logs)
#    - database/memory/backups/ (local backups)
#
# 5. Access memory from WhatsApp:
#    - .memory status (view system status)
#    - .memory help (view all commands)
#    - All memory commands are owner-only
#
# ============================================================================
